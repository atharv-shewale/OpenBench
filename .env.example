# ── OpenBench Environment Variables ──────────────────────────────────────────
# Copy to .env and fill in values. Never commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev:  leave blank (uses SQLite at ./openbench.db)
# Render/Prod: postgresql://user:password@host:5432/openbench
DATABASE_URL=

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong random string: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_use_secrets_token_hex_32

# ── JWT ───────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins (include frontend dev server in dev)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ── Demo Seed ─────────────────────────────────────────────────────────────────
# Set to "true" to auto-seed on first startup (dev/demo only)
AUTO_SEED=false

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development

