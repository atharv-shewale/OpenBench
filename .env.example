# ── OpenBench Environment Variables ──────────────────────────────────────────
# Copy to .env and configure for your environment. Never commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev default: blank / unset (falls back to SQLite at ./openbench.db)
# Render / Cloud PostgreSQL: postgresql://user:password@host:5432/openbench
DATABASE_URL=

# ── Security & Cryptography ───────────────────────────────────────────────────
# In production, set to a cryptographically secure 256-bit random hex string.
# On Render, this is auto-generated using `generateValue: true` in render.yaml.
# Local generation command: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me

# ── JWT Token Expiration ──────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS Origins ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,https://openbench-api.onrender.com

# ── Automated Seed (Judge-Proof Startup) ──────────────────────────────────────
# On startup, OpenBench automatically seeds an empty database.
# Set AUTO_SEED=true to force re-verification on application launch.
AUTO_SEED=true

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development

